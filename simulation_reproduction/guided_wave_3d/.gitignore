# Solver output directories are regenerated by the scripts; the *.npz bulk is already
# ignored at the repository root, so only the small JSON summaries get committed.
out_*/

# Large generated decks. The generator reproduces them in seconds; keeping a 20 MB
# text file in the repository would bloat every clone.
abaqus/ugw_plate_*.inp

# Abaqus run directories. Submitting a job writes a dozen artefacts alongside the
# deck (odb, mdl, stt, env, ...) and they are all reproducible from the .inp, which
# is committed. The generated abaqus_v6.env in particular is machine specific.
abaqus/runs/
*.odb
*.odb_f
*.mdl
*.prt
*.res
*.stt
*.com
*.msg
*.sta
*.sim
*.lck
*.abq
*.pac
*.sel
